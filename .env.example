# GemeinsamKI – Docker-Einstellungen
# Kopieren nach .env und anpassen:  cp .env.example .env

# Port auf dem Docker-Host (hinter einem Reverse-Proxy z. B. nur intern nutzen)
HTTP_PORT=8080

# Apache läuft mit dieser UID/GID, damit ./data auf dem Host deinem Benutzer gehört (id -u / id -g)
APP_UID=1000
APP_GID=1000

# Optionale Überschreibungen von data/config.json (leer lassen = Wert aus config.json)
GKI_PRIMARY_DOMAIN=
GKI_FORCE_HTTPS=
GKI_APP_SECRET=

GKI_SMTP_ENABLED=
GKI_SMTP_HOST=
GKI_SMTP_PORT=
GKI_SMTP_SECURE=
GKI_SMTP_USERNAME=
GKI_SMTP_PASSWORD=
GKI_SMTP_FROM=
GKI_NOTIFY_EMAIL=

GKI_CHAT_ENABLED=
GKI_CHAT_API_URL=
GKI_CHAT_API_KEY=
GKI_CHAT_MODEL=
